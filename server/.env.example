# Express
PORT=3001
# If you want to restrict CORS (dev), put your Vite URL here (example):
# CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=

# Datos del sistema anterior (SQL Server, dado de baja 2026-09-30): remitos los
# lee de la copia en Supabase (schema legacy_sqlserver, ver
# scripts/copiar_legacy_a_supabase.mjs). Las SQL_* solo las usa ese script de
# copia, NO hacen falta en el servidor (Render).
# SQL_SERVER=
# SQL_PORT=1433
# SQL_USER=
# SQL_PASSWORD=
# Empresa por defecto cuando el pedido no indica ?empresa= (Portones | Paneles)
SQL_DATABASE=Portones

# Supabase (Presupuestador, tickets y copia del sistema anterior)
SUPABASE_DATABASE_URL=
SUPABASE_SSL=true

# PDF
COMPANY_NAME=PORTONES

# PDF - Datos de cabecera (opcional, por defecto replica el ejemplo)
COMPANY_LEGAL_NAME=DFLEX ARGENTINA SAS
COMPANY_ADDR1=Ruta Nacional 9 Km. 658
COMPANY_ADDR2=Pilar - Cordoba
COMPANY_IVA=IVA Responsable Inscripto
COMPANY_CUIT=33-71608175-9
COMPANY_IIBB=284463706
COMPANY_START_DATE=01/09/2018

# If you build the React client and want Express to serve it:
SERVE_CLIENT=false
